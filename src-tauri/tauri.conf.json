{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AETHER OS",
  "version": "1.0.0",
  "identifier": "os.aether.workspace",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AETHER OS",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "transparent": true,
        "windowEffects": { "effects": ["mica"] },
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
